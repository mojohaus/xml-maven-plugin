<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.codehaus.mojo.xml</groupId>
  <artifactId>it22-rnc-valid</artifactId>
  <version>0.1</version>
  <name>Maven XML Plugin IT 22 valid</name>
  <description>Integration Test 22 valid for the Maven XML Plugin. Tests the
    situation where the maven plugin is configured to do RelaxNG validation
    and uses an explicit schemaFactoryClassName to specify that the Jing processor's
    Schema Factory should be used. The test uses a RelaxNG Schema, the XML is
    well-formed, and is invalid against the RelaxNG Schema and so should
    pass.
  </description>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>xml-maven-plugin</artifactId>
        <version>@project.version@</version>
        <dependencies>
          <dependency>
            <groupId>org.relaxng</groupId>
            <artifactId>jing</artifactId>
            <version>20241231</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <goals>
              <goal>validate</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <schemaFactory>com.thaiopensource.relaxng.jaxp.CompactSyntaxSchemaFactory</schemaFactory>
          <validationSets>
            <validationSet>
              <dir>xml</dir>
              <schemaLanguage>http://www.iana.org/assignments/media-types/application/relax-ng-compact-syntax</schemaLanguage>
              <systemId>${project.baseUri}schema.rnc</systemId>
            </validationSet>
          </validationSets>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

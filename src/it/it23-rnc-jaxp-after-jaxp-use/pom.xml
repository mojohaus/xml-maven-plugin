<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.codehaus.mojo.xml</groupId>
  <artifactId>it23-rnc-jaxp-after-jaxp-use</artifactId>
  <version>0.1</version>
  <name>Maven XML Plugin IT 23</name>
  <description>Integration Test 23 for the Maven XML Plugin. Same as IT 21 valid,
    but an earlier execution creates a SAXParserFactory first, so the JDK has
    already read its JAXP configuration when validate sets the JAXP
    Configuration File. The Jing Schema Factory named in that file must still
    be used.</description>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>xml-maven-plugin</artifactId>
        <version>@project.version@</version>
        <dependencies>
          <dependency>
            <groupId>org.relaxng</groupId>
            <artifactId>jing</artifactId>
            <version>20241231</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <!-- constructing the check-format mojo creates a SAXParserFactory -->
            <id>use-jaxp-first</id>
            <phase>initialize</phase>
            <goals>
              <goal>check-format</goal>
            </goals>
            <configuration>
              <skip>true</skip>
            </configuration>
          </execution>
          <execution>
            <goals>
              <goal>validate</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <jaxpConfigFile>${project.basedir}/jaxp.properties</jaxpConfigFile>
          <validationSets>
            <validationSet>
              <dir>xml</dir>
              <schemaLanguage>http://www.iana.org/assignments/media-types/application/relax-ng-compact-syntax</schemaLanguage>
              <systemId>${project.baseUri}schema.rnc</systemId>
            </validationSet>
          </validationSets>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
